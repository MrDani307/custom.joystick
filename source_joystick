local function doJump()
    local char = Player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.FloorMaterial ~= Enum.Material.Air then
            local currentState = hum:GetState()
            if currentState ~= Enum.HumanoidStateType.Jumping and currentState ~= Enum.HumanoidStateType.Freefall then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end

local jumpHolding = false

local function onJumpStart()
    if jumpHolding then return end
    jumpHolding = true
    task.spawn(function()
        while jumpHolding do
            doJump()
            task.wait(0.01)
        end
    end)
end

local function onJumpEnd()
    jumpHolding = false
end

JumpButton.MouseButton1Down:Connect(function()
    if not isSystemOn then return end
    JumpButton.BackgroundTransparency = 0.3
    JumpButton.ImageColor3 = Color3.fromRGB(180, 180, 180)
    onJumpStart()
end)

JumpButton.MouseButton1Up:Connect(function()
    JumpButton.BackgroundTransparency = 0.5
    JumpButton.ImageColor3 = Color3.fromRGB(255, 255, 255)
    onJumpEnd()
end)

JumpButton.MouseLeave:Connect(function()
    JumpButton.BackgroundTransparency = 0.5
    JumpButton.ImageColor3 = Color3.fromRGB(255, 255, 255)
    onJumpEnd()
end)

local function setStandardControls(visible)
    pcall(function()
        local touchGui = Player.PlayerGui:FindFirstChild("TouchGui")
        if touchGui then
            touchGui.Enabled = visible
            local frame = touchGui:FindFirstChild("TouchControlFrame")
            if frame then
                frame.Visible = visible
                local jump = frame:FindFirstChild("JumpButton")
                if jump then jump.Visible = visible end
                local stick = frame:FindFirstChild("DynamicThumbstick")
                if stick then stick.Visible = visible end
            end
        end
    end)
end

local function toggleSystem(state)
    if not state then showNotification("Wait...") end
    isSystemOn = state
    ScreenGui.Enabled = state
    if not state then
        setStandardControls(true)
        dragging = false
        movedOnce = false
        inputObject = nil
        Base.Visible = false
        Stick.Visible = false
        for _, d in pairs(dots) do d.Visible = false end
        moveVector = Vector3.new(0, 0, 0)
        CaptureArea.Active = true
    end
end do
    
end

Player.Chatted:Connect(function(msg)
    local m = msg:lower()
    if m == "on" then
        toggleSystem(true)
    elseif m == "off" then
        toggleSystem(false)
    elseif m == "wer" then
        clickBlockEnabled = true
        saveSetting(true)
    elseif m == "rew" then
        clickBlockEnabled = false
        saveSetting(false)
    end
end)

local dragging = false
local inputObject = nil
local moveVector = Vector3.new(0, 0, 0)
local startPos = Vector2.new(0, 0)
local movedOnce = false

local function updateJoystickVisuals(currentPos, diff)
    local direction = diff.Unit
    Stick.Position = UDim2.new(0, currentPos.X - 22.5, 0, currentPos.Y - 22.5)
    for i, dot in pairs(dots) do
        local ratio = i / 7
        local dotPos = startPos + (diff * ratio)
        dot.Position = UDim2.new(0, dotPos.X - (dot.Size.X.Offset/2), 0, dotPos.Y - (dot.Size.Y.Offset/2))
    end
    moveVector = Vector3.new(direction.X, 0, direction.Y)
end

CaptureArea.InputBegan:Connect(function(input)
    if not isSystemOn then return end
    if dragging then return end
    if input.UserInputType ~= Enum.UserInputType.Touch
        and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

    dragging = true
    movedOnce = false
    inputObject = input
    startPos = Vector2.new(input.Position.X, input.Position.Y)

    if not clickBlockEnabled then
        Base.Position = UDim2.new(0, startPos.X - 20, 0, startPos.Y - 20)
        Stick.Position = UDim2.new(0, startPos.X - 22.5, 0, startPos.Y - 22.5)
        Base.Visible = true
        Stick.Visible = true
        for _, d in pairs(dots) do
            d.Position = UDim2.new(0, startPos.X - (d.Size.X.Offset/2), 0, startPos.Y - (d.Size.Y.Offset/2))
            d.Visible = true
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isSystemOn and dragging and input == inputObject then
        local currentPos = Vector2.new(input.Position.X, input.Position.Y)
        local diff = currentPos - startPos

        if clickBlockEnabled then
            if not movedOnce and diff.Magnitude > 10 then
                movedOnce = true
                CaptureArea.Active = false
                Base.Position = UDim2.new(0, startPos.X - 20, 0, startPos.Y - 20)
                Base.Visible = true
                Stick.Visible = true
                for _, d in pairs(dots) do
                    d.Position = UDim2.new(0, startPos.X - (d.Size.X.Offset/2), 0, startPos.Y - (d.Size.Y.Offset/2))
                    d.Visible = true
                end
            end
            if movedOnce and diff.Magnitude > 0 then
                updateJoystickVisuals(currentPos, diff)
            end
        else
            if not movedOnce and diff.Magnitude > 2 then
                movedOnce = true
                CaptureArea.Active = false
            end
            if diff.Magnitude > 0 then
                updateJoystickVisuals(currentPos, diff)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == inputObject then
        dragging = false
        movedOnce = false
        inputObject = nil
        Base.Visible = false
        Stick.Visible = false
        for _, d in pairs(dots) do d.Visible = false end
        moveVector = Vector3.new(0, 0, 0)
        CaptureArea.Active = true
    end
end)

Stick.InputBegan:Connect(function(input)
    if isSystemOn and Stick.Image ~= "" and dragging and (not clickBlockEnabled or movedOnce) then
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            Stick.BackgroundTransparency = 0.3
            Stick.ImageColor3 = Color3.fromRGB(180, 180, 180)
        end
    end
end)

Stick.InputEnded:Connect(function(input)
    if Stick.Image ~= "" then
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            Stick.BackgroundTransparency = 0.5
            Stick.ImageColor3 = Color3.fromRGB(255, 255, 255)
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if isSystemOn then
        pcall(function()
            local touchGui = Player.PlayerGui:FindFirstChild("TouchGui")
            if touchGui then
                touchGui.Enabled = false
                local frame = touchGui:FindFirstChild("TouchControlFrame")
                if frame then
                    frame.Visible = false
                    local jump = frame:FindFirstChild("JumpButton")
                    if jump then jump.Visible = false end
                    local stick = frame:FindFirstChild("DynamicThumbstick")
                    if stick then stick.Visible = false end
                end
            end
        end)

        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid:Move(moveVector, true)
        end
    end
end)

task.spawn(function()
    task.wait(1)
    if isSystemOn then
        pcall(function()
            local touchGui = Player.PlayerGui:FindFirstChild("TouchGui")
            if touchGui then touchGui.Enabled = false end
        end)
    end
end)
