local Stick = Instance.new("ImageButton", ScreenGui)
Stick.Name = "CustomStick"
Stick.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Stick.BackgroundTransparency = 0.5
Stick.Size = UDim2.new(0, 45, 0, 45)
Stick.Visible = false
Stick.ZIndex = 11
Instance.new("UICorner", Stick).CornerRadius = UDim.new(1, 0)

local function getFirstFileFromFolder(folder)
    if listfiles and isfolder(folder) then
        local files = listfiles(folder)
        if #files > 0 then
            return files[1]
        end
    end
    return nil
end

task.spawn(function()
    while true do
        local file = getFirstFileFromFolder(joystickFolderName)
        if file then
            local success, asset = pcall(function()
                return getcustomasset(file)
            end)
            if success and asset then
                Stick.Image = asset
                Base.Image = asset
                for _, dot in pairs(dots) do
                    dot.Image = asset
                end
                break
            end
        end
        task.wait(0.5)
    end
end)

