Stem.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

task.spawn(function()
    while true do
        local file = getFirstFileFromFolder(imageFolderName)
        if file then
            local success, asset = pcall(function()
                return getcustomasset(file)
            end)
            if success and asset then
                JumpButton.Image = asset
                ArrowIcon.Visible = false
                break
            end
